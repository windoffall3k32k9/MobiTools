<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:orientation="vertical">

    <include layout="@layout/layout_tool_toolbar" />

    <!-- Cảnh báo khi thiết bị thiếu cảm biến -->
    <TextView
        android:id="@+id/tvCompassSensorWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="#FEF2F2"
        android:padding="12dp"
        android:text="@string/compass_sensor_missing"
        android:textColor="@color/colorDanger"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- KHỐI HIỂN THỊ HƯỚNG VÀ SỐ ĐỘ NẰM PHÍA TRÊN LA BÀN -->
    <LinearLayout
        android:id="@+id/layoutHeadingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Tên hướng địa lý viết rõ ràng đầy đủ tiếng Việt (không viết tắt) -->
        <TextView
            android:id="@+id/tvDirectionFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Bắc"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Số độ phương vị hiển thị bên dưới tên hướng -->
        <TextView
            android:id="@+id/tvAzimuthDegree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="0°"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- KHUNG CHỨA MẶT LA BÀN LIỀN KHỐI VỚI KIM NAM CHÂM 2 ĐẦU N - S -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <!-- Mặt số la bàn và kim nam châm xoay đồng nhất -->
        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center">

            <!-- Dial la bàn và kim nam châm 2 đầu N-S liền thành 1 khối cùng xoay theo góc phương vị -->
            <com.example.baseproject.ui.compass.CompassDialView
                android:id="@+id/compassDialView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Vạch chuẩn góc 12 giờ cố định chỉ hướng nhìn hiện tại -->
            <View
                android:layout_width="3.5dp"
                android:layout_height="24dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_compass_index_line" />

        </FrameLayout>

    </FrameLayout>

    <!-- KHU VỰC HIỂN THỊ TỌA ĐỘ ĐỊNH DẠNG ĐỘ PHÚT GIÂY -->
    <LinearLayout
        android:id="@+id/layoutLocationInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Tọa độ Kinh độ / Vĩ độ theo định dạng Độ Phút Giây -->
        <TextView
            android:id="@+id/tvCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="--°--'--&quot; B  --°--'--&quot; Đ"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Nút xin cấp quyền vị trí nếu chưa có -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantLocationPermission"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2563EB"
            android:text="Cấp quyền vị trí"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
