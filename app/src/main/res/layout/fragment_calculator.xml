                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="C"
                android:textColor="@color/calcOrange"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="@color/calcButtonBg"
