<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:orientation="vertical">

    <!-- Thanh tiêu đề công cụ chuẩn -->
    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/layout_tool_toolbar" />

    <!-- Khu vực hiển thị lịch sử tính toán, biểu thức và kết quả trực tiếp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <!-- Danh sách lịch sử tính toán cuộn tự động phía trên -->
        <ScrollView
            android:id="@+id/scrollHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="true"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/layoutHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom|end"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Dòng biểu thức chính đang gõ -->
        <HorizontalScrollView
            android:id="@+id/scrollExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:ellipsize="none"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/textPrimary"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="46.464 + 56.464" />
        </HorizontalScrollView>

        <!-- Dòng xem trước kết quả trực tiếp -->
        <HorizontalScrollView
            android:id="@+id/scrollPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvPreviewResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/textSecondary"
                android:textSize="22sp"
                tools:text="= 102.928" />
        </HorizontalScrollView>

    </LinearLayout>

    <!-- Đường phân cách thanh mảnh -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="@color/colorBorder" />

    <!-- Khung chứa 2 chế độ bàn phím: Tiêu chuẩn (4x5) và Nâng cao (5x7) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <!-- ============================================== -->
