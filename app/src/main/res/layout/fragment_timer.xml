<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <include layout="@layout/layout_tool_toolbar" />

    <!-- KHUNG CHỨA CHÍNH: 2 TRẠNG THÁI (CHỌN SỐ VÀ ĐANG ĐẾM NGƯỢC) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= TRẠNG THÁI 1: CHỌN SỐ (SELECTION) ================= -->
        <LinearLayout
            android:id="@+id/layoutSelectionView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Đặt thời gian đếm ngược"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Bảng cuộn 3 cột Giờ - Phút - Giây -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E293B"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Cột Giờ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <NumberPicker
                        android:id="@+id/pickerHours"
                        android:layout_width="wrap_content"
                        android:layout_height="180dp"
                        android:descendantFocusability="blocksDescendants"
                        android:theme="@style/ThemeOverlay.MaterialComponents.Dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="giờ"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Cột Phút -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <NumberPicker
                        android:id="@+id/pickerMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="180dp"
                        android:descendantFocusability="blocksDescendants"
                        android:theme="@style/ThemeOverlay.MaterialComponents.Dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="phút"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Cột Giây -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <NumberPicker
                        android:id="@+id/pickerSeconds"
                        android:layout_width="wrap_content"
                        android:layout_height="180dp"
                        android:descendantFocusability="blocksDescendants"
                        android:theme="@style/ThemeOverlay.MaterialComponents.Dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="giây"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Các nút cộng nhanh thời gian -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd1Min"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="+1m"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="#334155"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd5Min"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="+5m"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="#334155"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd10Min"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="+10m"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="#334155"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd30Min"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="+30m"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="#334155"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Nút Bắt đầu tròn lớn chính giữa -->
            <ImageView
                android:id="@+id/btnStartPicker"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_circle_orange"
                android:contentDescription="@string/start"
                android:padding="20dp"
                android:src="@drawable/ic_play_arrow"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- ================= TRẠNG THÁI 2: ĐANG CHẠY / TẠM DỪNG (RUNNING) ================= -->
        <LinearLayout
            android:id="@+id/layoutRunningView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <!-- Vòng tròn kim vạch tỏa tròn xung quanh thời gian -->
            <FrameLayout
                android:layout_width="300dp"
                android:layout_height="300dp">

                <com.example.baseproject.ui.timer.TimerTickDialView
                    android:id="@+id/timerTickDialView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRunningDigits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="00:29:58"
                        android:textColor="#FFFFFF"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tổng 30 phút"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_alarm_bell"
                            app:tint="#94A3B8" />

                        <TextView
                            android:id="@+id/tvEndTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Kết thúc: --:--"
                            android:textColor="#94A3B8"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRunningStateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Đang đếm ngược…"
                        android:textColor="#FF7A00"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

            <!-- Thanh điều khiển 2 nút: Hủy/Dừng hẳn (trái) và Tạm dừng/Tiếp tục (phải) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Nút dừng hẳn (Stop/Cancel) -> quay về màn hình chọn số -->
                <ImageView
                    android:id="@+id/btnStopCountdown"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="36dp"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="@string/reset"
                    android:padding="16dp"
                    android:src="@drawable/ic_close_circle"
                    app:tint="#E2E8F0" />

                <!-- Nút tạm dừng / tiếp tục (Pause/Resume) -> dừng/tiếp tục tại chỗ, không quay về -->
                <ImageView
                    android:id="@+id/btnPauseCountdown"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="36dp"
                    android:background="@drawable/bg_circle_orange"
                    android:contentDescription="@string/pause"
                    android:padding="18dp"
                    android:src="@drawable/ic_pause"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
